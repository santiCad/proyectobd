<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.cell.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.universidad.proyecto.controller.CursosController"
      styleClass="module-container"
      spacing="0">

    
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="📚" styleClass="module-icon"/>
        <VBox spacing="2">
            <Label text="Gestión de Cursos" styleClass="module-title"/>
            <Label text="Crear, editar y eliminar cursos con sus módulos" styleClass="module-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nuevo Curso" styleClass="btn-primary" onAction="#openCreateDialog"/>
    </HBox>

    
    <HBox styleClass="search-bar" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar"
                   promptText="Buscar por título o categoría…"
                   prefWidth="300"
                   styleClass="search-field"
                   onKeyReleased="#onBuscar"/>
        <ComboBox fx:id="cmbEstadoFiltro"
                  promptText="Estado"
                  prefWidth="140"
                  styleClass="combo-filter"
                  onAction="#onBuscar"/>
        <Button text="↺ Limpiar" styleClass="btn-secondary" onAction="#onLimpiar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblConteo" styleClass="record-count"/>
    </HBox>

    
    <TableView fx:id="tablaCursos"
               VBox.vgrow="ALWAYS"
               styleClass="data-table">
        <placeholder><Label text="No se encontraron cursos"/></placeholder>
        <columns>
            <TableColumn fx:id="colId"          text="ID"          prefWidth="55"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colTitulo"       text="Título"      prefWidth="220"/>
            <TableColumn fx:id="colCategoria"    text="Categoría"   prefWidth="120"/>
            <TableColumn fx:id="colInstructor"   text="Instructor"  prefWidth="150"/>
            <TableColumn fx:id="colPrecio"       text="Precio"      prefWidth="90"  style="-fx-alignment: CENTER_RIGHT;"/>
            <TableColumn fx:id="colEstado"       text="Estado"      prefWidth="110" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colFecha"        text="Creación"    prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colAcciones"     text="Acciones"    prefWidth="120" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

    
    <TitledPane fx:id="panelModulos"
                text="📦 Módulos del curso seleccionado"
                expanded="false"
                styleClass="modules-panel">
        <VBox spacing="8" styleClass="modules-inner">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Curso:" styleClass="field-label"/>
                <Label fx:id="lblCursoSeleccionado" text="— selecciona un curso arriba —"
                       styleClass="selected-course-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Módulo" styleClass="btn-primary-sm"
                        onAction="#openModuloDialog" fx:id="btnAddModulo" disable="true"/>
            </HBox>
            <TableView fx:id="tablaModulos"
                       prefHeight="160"
                       styleClass="data-table-sm">
                <placeholder><Label text="Selecciona un curso para ver sus módulos"/></placeholder>
                <columns>
                    <TableColumn fx:id="colModId"      text="#"      prefWidth="50" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colModOrden"   text="Orden"  prefWidth="60" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colModTitulo"  text="Título" prefWidth="300"/>
                    <TableColumn fx:id="colModAcciones" text="Acciones" prefWidth="120" style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

</VBox>
